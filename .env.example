# API Configuration
API_KEY=your_secret_api_key_here

# ============================================
# LLM Provider Configuration
# ============================================
# Choose one: openai, azure_openai, or anthropic
LLM_PROVIDER=openai

# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o

# ============================================
# Azure OpenAI Configuration
# ============================================
# AZURE_OPENAI_API_KEY=your_azure_api_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# ============================================
# Anthropic Configuration
# ============================================
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key
# LLM_MODEL=claude-sonnet-4.5-20241022

# ============================================
# GUVI Configuration
# ============================================
GUVI_CALLBACK_URL=https://hackathon.guvi.in/api/updateHoneyPotFinalResult

# ============================================
# Agent Configuration
# ============================================
MAX_CONVERSATION_TURNS=10
SCAM_CONFIDENCE_THRESHOLD=0.5
MIN_MESSAGES_BEFORE_CALLBACK=2

# Human-like behavior simulation
# Keep false to stay within 30s API timeout
ENABLE_HUMAN_DELAY=false

# ============================================
# Dashboard Configuration
# ============================================
DASHBOARD_PASSWORD=admin123
